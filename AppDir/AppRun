#!/bin/sh
# Uses the host's Python + PyGObject + GTK 3, so the AppImage stays tiny.
HERE="$(dirname "$(readlink -f "$0")")"
for py in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
  if command -v "$py" >/dev/null 2>&1 &&
     "$py" -c 'import gi; gi.require_version("Gtk", "3.0")' >/dev/null 2>&1; then
    exec "$py" "$HERE/usr/share/dtprobe/dtprobe.py" "$@"
  fi
done
echo "dtprobe: needs python3 with PyGObject and GTK 3" >&2
echo "  Debian/Ubuntu: python3-gi gir1.2-gtk-3.0   Fedora: python3-gobject gtk3   Arch: python-gobject gtk3" >&2
exit 1
